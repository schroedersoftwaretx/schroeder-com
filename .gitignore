# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated at prebuild by scripts/generate-rss.mjs
/public/rss.xml

# planning docs, project handoffs, career notes — contain personal contact
# details and project internals; not for a public repo
/notes/

# LaTeX resume sources — the header carries a phone number, and this repo is
# public. The rendered PDF in public/ is the intentionally published artifact.
/resume/

# misc
.DS_Store
*.pem
.vscode
.idea
.claude

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env

# typescript
*.tsbuildinfo
next-env.d.ts
